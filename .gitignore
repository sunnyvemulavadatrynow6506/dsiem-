dsiem/temp/
dsiem/logs/
dsiem/dsiem_config.json
dsiem/web/dist/
dsiem/web/ui/dist/
dsiem/web/ui/node_modules/

# Source archive: the extracted tree lives in griffendo/
Griffendo_v5.1_source.zip

# Editors / OS
.vscode/
.idea/
.DS_Store
